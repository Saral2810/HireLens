# ==============================================================================
# HR Screening Voice Agent — environment settings
# Copy this file to ".env" and fill in YOUR values. Never commit the real .env.
# ==============================================================================

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
APP_TIMEZONE=Asia/Kolkata

# ── Supabase (your contest project only) ─────────────────────────────────────
SUPABASE_URL=
# Backend key with full access — keep it secret, server-side only.
SUPABASE_SERVICE_ROLE_KEY=
# (alternative to the line above: newer "sb_secret_..." key)
SUPABASE_SECRET_KEY=
# Publishable key: safe for the browser, used for invite-link logins (roadmap Phase D).
SUPABASE_PUBLISHABLE_KEY=

# ── Login / roles ────────────────────────────────────────────────────────────
# Comma-separated emails that get the HR (super-admin) role.
SUPER_ADMIN_EMAILS=

# ── Gnani Speech APIs (Prisma speech-to-text, Timbre text-to-speech) ─────────
# Key from app.gnani.ai/voice → API keys. Sent as the X-API-Key-ID header.
GNANI_SPEECH_API_KEY=
# Prisma language: en-IN accepts Hindi–English mixed speech and returns Latin script.
GNANI_STT_LANGUAGE=en-IN
# Timbre model and voice (see docs.gnani.ai/api/TTS/available-voices). Poorvi is the Hinglish (hi-en) voice.
GNANI_TTS_MODEL=timbre-v2.5
GNANI_TTS_VOICE=Poorvi
# Timbre language: hi-en = Hinglish, en-IN = English, hi-IN = Hindi.
GNANI_TTS_LANGUAGE=hi-en

# ── Brain (any OpenAI-compatible chat-completions API) ───────────────────────
# Evon on the Victus laptop: http://127.0.0.1:8080/v1/chat/completions (see the Evon guide)
# or a hosted backup LLM.
LLM_API_URL=
LLM_API_KEY=
LLM_MODEL=
# 'bearer' (Authorization: Bearer <key>) or 'api-key' (Azure style header)
LLM_AUTH_HEADER=bearer
# Reasoning models only (e.g. openai/gpt-oss-120b on Groq): low = fastest replies. Leave blank for Evon.
LLM_REASONING_EFFORT=
