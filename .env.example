# ==============================================================================
# HR Screening Voice Agent — environment settings
# Copy this file to ".env" and fill in YOUR values. Never commit the real .env.
# ==============================================================================

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
APP_TIMEZONE=Asia/Kolkata

# ── Supabase (your contest project only) ─────────────────────────────────────
SUPABASE_URL=
# Backend key with full access — keep it secret, server-side only.
SUPABASE_SERVICE_ROLE_KEY=
# (alternative to the line above: newer "sb_secret_..." key)
SUPABASE_SECRET_KEY=

# ── Login / roles ────────────────────────────────────────────────────────────
# HR vs candidate comes from the profiles table (see database/README.md).
# Address candidates open from their invite links. Blank = the address HR is using.
# Emailed links use this address, so set it to a URL that will still work when candidates open the email.
# With ngrok: PUBLIC_APP_URL=https://<NGROK_DOMAIN>, then start everything with `npm run public`.
PUBLIC_APP_URL=
# Your free fixed ngrok domain (ngrok dashboard → Domains), e.g. your-name.ngrok-free.app
NGROK_DOMAIN=

# ── Invite emails (sent from YOUR mailbox when a campaign runs; not from Supabase) ──
# Personal Gmail: turn on 2-Step Verification, then create an App Password
# (Google Account → Security → 2-Step Verification → App passwords) and paste it as SMTP_PASS.
# Gmail sends up to ~500 emails a day from a personal account. Any other SMTP provider works too.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# What candidates see as the sender. Gmail requires your own address here.
MAIL_FROM="Your Name (Hiring) <you@gmail.com>"
MAIL_REPLY_TO=
# Signs the personal links in invite emails (32+ random characters). Blank = derived from the Supabase key.
INVITE_SECRET=
# Days an emailed link keeps working (closing the campaign stops it sooner).
INVITE_LINK_DAYS=30

# ── Safety limits (all optional; the defaults are safe) ──────────────────────
# Where the server listens. 127.0.0.1 = this computer only (ngrok connects locally). Docker uses 0.0.0.0.
HOST=127.0.0.1
# Calls at the same time; more candidates wait in a queue and join automatically. 15 keeps replies
# under 10 s with one Gnani key (measured with the 100-candidate simulation).
MAX_ACTIVE_CALLS=15
# Give up on one Gnani / LLM request after this long, so one stuck request cannot freeze every call.
GNANI_TIMEOUT_MS=15000
LLM_TIMEOUT_MS=20000

# ── Gnani Speech APIs (Prisma speech-to-text, Timbre text-to-speech) ─────────
# Key from app.gnani.ai/voice → API keys. Sent as the X-API-Key-ID header.
GNANI_SPEECH_API_KEY=
# Prisma language: en-IN accepts Hindi–English mixed speech and returns Latin script.
# Speech-to-text model: prisma-v3.0 (default; clips up to 30 s, longer answers are sent in parts) or prisma-v2.5.
GNANI_STT_MODEL=prisma-v3.0
GNANI_STT_LANGUAGE=en-IN
# Timbre model and voice (see docs.gnani.ai/api/TTS/available-voices). Poorvi is the Hinglish (hi-en) voice.
GNANI_TTS_MODEL=timbre-v2.5
GNANI_TTS_VOICE=Poorvi
# Timbre language: hi-en = Hinglish, en-IN = English, hi-IN = Hindi.
GNANI_TTS_LANGUAGE=hi-en
# Candidates pick the call language (English + Hindi by default, or English only, or Hindi only).
# Optional overrides per language; empty = en-IN / hi-IN for speech-to-text and GNANI_TTS_LANGUAGE for the voice.
GNANI_STT_LANGUAGE_EN=
GNANI_STT_LANGUAGE_HI=
GNANI_TTS_LANGUAGE_EN=
GNANI_TTS_LANGUAGE_HI=
# Voice the shared lines (HR questions, company briefing) in the background when a campaign is run. 0 = off.
PREVOICE_ON_RUN=1

# ── Brain (any OpenAI-compatible chat-completions API) ───────────────────────
# Evon on the Victus laptop: http://127.0.0.1:8080/v1/chat/completions (see the Evon guide)
# or a hosted backup LLM.
LLM_API_URL=
LLM_API_KEY=
LLM_MODEL=
# 'bearer' (Authorization: Bearer <key>) or 'api-key' (Azure style header)
LLM_AUTH_HEADER=bearer
# Reasoning models only (e.g. openai/gpt-oss-120b on Groq): low = fastest replies. Leave blank for Evon.
LLM_REASONING_EFFORT=

# ─── Candidate Google sign-in (no Supabase address shown) ───
# Google's own sign-in button is used on the login page. Put the OAuth client ID that Supabase uses
# (Supabase → Authentication → Providers → Google → Client ID) here, and in Google Cloud Console add
# your app address (PUBLIC_APP_URL, e.g. https://yourname.ngrok.app, and http://localhost:3000) under
# that client's "Authorized JavaScript origins". Empty = no Google button (email code only).
GOOGLE_CLIENT_ID=

# ─── Campaign scheduling ───
# How often the server checks for scheduled campaigns to start or close (ms). Scheduled invite
# emails use PUBLIC_APP_URL for their links, so set it when you schedule campaigns.
SCHEDULER_INTERVAL_MS=60000
