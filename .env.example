# ==============================================================================
# Gnani.ai platform — environment settings
# Copy this file to ".env" and fill in YOUR values. Never commit the real .env.
# Anything left blank simply turns that feature off.
# ==============================================================================

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
APP_NAME=Gnani.ai
APP_TIMEZONE=Asia/Kolkata
# Public URL of this server. Voice-provider webhooks are sent here, e.g.
#   https://your-domain.com/leads/webhook/gnani
# For local testing use a tunnel (ngrok, cloudflared) URL.
PUBLIC_APP_URL=

# ── Your Supabase project (leave blank to run in offline MOCK mode) ──────────
SUPABASE_URL=
# Backend key with full access — keep it secret, server-side only.
SUPABASE_SERVICE_ROLE_KEY=
# (optional, newer Supabase key formats)
SUPABASE_SECRET_KEY=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_JWKS_URL=

# ── Login / roles ────────────────────────────────────────────────────────────
# Comma-separated emails that get Super Admin rights.
SUPER_ADMIN_EMAILS=
# (optional) Supabase auth user id of your super admin — auto-added to new tenants.
SUPERADMIN_USER_ID=
# Offline mock mode only: password for superadmin@local.dev (or any SUPER_ADMIN_EMAILS entry).
MOCK_ADMIN_PASSWORD=ChangeMe@123
# Keep false. "Bearer mock-..." dev tokens are refused when Supabase is connected unless true.
ALLOW_MOCK_AUTH=false

# ── Encryption for saved provider credentials ───────────────────────────────
# Exactly 32 characters. Generate one:
#   node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"
CREDENTIAL_ENCRYPTION_KEY=
# (optional) old keys, comma-separated, while rotating
CREDENTIAL_ENCRYPTION_KEY_PREVIOUS=

# ── Voice provider: Gnani.ai (the "brain") ──────────────────────────────────
DEFAULT_VOICE_PROVIDER=gnani
GNANI_API_BASE=
GNANI_API_KEY=
GNANI_AGENT_ID=
GNANI_AGENT_NAME=Gnani Voice Agent
GNANI_CALLER_ID=
GNANI_WEBHOOK_SECRET=
# (optional) comma-separated hosts whose recordings need the provider's auth to play
PROXY_RECORDING_HOSTS=

# ── LLM for transcript analysis / lead scoring (any OpenAI-compatible API) ──
# Leave blank to use the built-in offline rule-based analyzer.
LLM_API_URL=
LLM_API_KEY=
LLM_MODEL=
# 'bearer' (Authorization: Bearer <key>) or 'api-key' (Azure style header)
LLM_AUTH_HEADER=bearer

# ── Dialer ──────────────────────────────────────────────────────────────────
DIALER_ENABLED=true
# India TRAI calling window is 09:00–21:00. Only bypass for testing.
BYPASS_CALLING_HOURS=false
DIALER_POLL_INTERVAL_MS=5000
DIALER_PACING_DELAY_MS=
DIALER_TICK_TIMEOUT_MS=
DIAL_ALL_LOCKOUT_MS=
STALE_CALL_TIMEOUT_MS=90000
STALE_RETRIGGER_MIN_INTERVAL_MS=
# Ping /health every 4 minutes (for free hosting tiers that sleep). Needs PUBLIC_APP_URL.
KEEP_ALIVE_SELF_PING=false

# ── Redis (campaign scheduler / BullMQ) ─────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Optional extras ─────────────────────────────────────────────────────────
SLACK_WEBHOOK_URL=
CRM_PROVIDER=
WHATSAPP_ENABLED=false
