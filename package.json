{
  "name": "hr-screening-voice-agent",
  "version": "0.1.0",
  "description": "HR screening voice agent: candidates take a short browser voice call (Gnani Prisma + Timbre + an LLM brain); HR reviews results by batch.",
  "main": "backend/src/server.js",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "start": "node backend/src/server.js",
    "dev": "node --watch backend/src/server.js",
    "build": "npm --prefix client install && npm --prefix client run build",
    "client:install": "npm --prefix client install",
    "client:build": "npm --prefix client run build",
    "client:dev": "npm --prefix client run dev",
    "test": "node --import ./tests/setup.js --test \"tests/unit/*.test.js\"",
    "docker:build": "docker build -t hr-screening-voice-agent:latest .",
    "docker:run": "docker run -p 3000:3000 --env-file .env hr-screening-voice-agent:latest"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "express": "^4.19.2",
    "multer": "^2.5.0",
    "unpdf": "^1.9.1"
  }
}
